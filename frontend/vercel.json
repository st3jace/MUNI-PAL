{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx vite build --config vite.config.healthcare.ts && npx vite build --config vite.config.sensing.ts --base /tools/ --outDir dist-healthcare/tools && npx vite build --config vite.config.readiness.ts --outDir dist-healthcare/readiness",
  "outputDirectory": "dist-healthcare",
  "rewrites": [
    {
      "source": "/api/v1/sensing/:path*",
      "destination": "https://api.muni-pal.io/api/v1/sensing/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.muni-pal.io/health"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "readiness.elaunchshop.com" }],
      "destination": "/readiness/index.readiness.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "readiness.elaunchshop.com" }],
      "destination": "/readiness/index.readiness.html"
    },
    {
      "source": "/tools/:path*",
      "destination": "/tools/index.sensing.html"
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "readiness.elaunchshop.com" }],
      "destination": "/index.healthcare.html"
    }
  ]
}
