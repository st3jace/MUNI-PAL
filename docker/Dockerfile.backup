FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-boto3 python3-psycopg2 age ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY ops/backups/backup.py /app/backup.py
ENV PYTHONUNBUFFERED=1
USER postgres
ENTRYPOINT []
CMD ["python3", "/app/backup.py", "backup"]
