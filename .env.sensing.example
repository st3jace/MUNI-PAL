# =============================================================================
# Muni-Pal Sensing Microservice — Environment Variables
# assess.launchshop.io
#
# SETUP:
#   cp .env.sensing.example .env.sensing
#   Fill in all values marked REQUIRED
#   Never commit .env.sensing to version control
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
SECRET_KEY=REQUIRED_change_this_to_a_long_random_string_64chars_min

# ---------------------------------------------------------------------------
# Sensing CORS — comma-separated list of allowed origins
# ---------------------------------------------------------------------------
SENSING_CORS_ORIGINS=https://assess.launchshop.io,https://launchshop.io

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase / Neon / Railway / self-hosted)
# Lead capture and funnel event storage
# ---------------------------------------------------------------------------
POSTGRES_USER=REQUIRED
POSTGRES_PASSWORD=REQUIRED
POSTGRES_DB=munipal_sensing
# POSTGRES_HOST is set to sensing-postgres in docker-compose.sensing.yml
# Override here if using an external hosted DB:
# POSTGRES_HOST=db.yourhost.supabase.co
# USE_SQLITE must be false in production
USE_SQLITE=false

# ---------------------------------------------------------------------------
# Redis Cloud (Upstash / Redis Cloud free tier works well here)
# Used for rate limiting state (slowapi) and Celery broker
# ---------------------------------------------------------------------------
# Option A — provide full URL (recommended for Redis Cloud / Upstash)
REDIS_URL=rediss://:REQUIRED_password@REQUIRED_host:REQUIRED_port/0

# Option B — individual fields (used if REDIS_URL is not set)
REDIS_HOST=REQUIRED
REDIS_PORT=6380
REDIS_PASSWORD=REQUIRED
REDIS_TLS=true
REDIS_SSL_CERT_REQS=required

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
TELEMETRY_ENABLED=true
TELEMETRY_JSONL_PATH=/app/reports/phase10_postlaunch/ops1001_telemetry_events.jsonl

# ---------------------------------------------------------------------------
# Anthropic (not required for sensing-only — EMMA is corpus-based)
# Leave blank unless you add LLM-backed features to the sensing layer
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# JWT (not used in public sensing endpoints — placeholder for future auth)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=REQUIRED_change_this_to_a_long_random_string

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# EMMA corpus data is bundled in the Docker image at /app/emma/bond_os_extractor
# No external corpus download needed at runtime.
#
# To rotate secrets:
#   1. Update values in .env.sensing
#   2. docker compose -f docker-compose.sensing.yml --env-file .env.sensing up -d --force-recreate sensing-api
#
# TLS certificates:
#   First-time issuance (run before starting nginx):
#   docker compose -f docker-compose.sensing.yml run --rm certbot certonly \
#     --webroot -w /var/www/certbot \
#     -d assess.launchshop.io \
#     --email admin@launchshop.io --agree-tos --no-eff-email
