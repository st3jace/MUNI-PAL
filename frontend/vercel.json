{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx vite build --config vite.config.healthcare.ts && npx vite build --config vite.config.sensing.ts --base /tools/ --outDir dist-healthcare/tools && npx vite build --config vite.config.readiness.ts --base /readiness/ --outDir dist-healthcare/readiness",
  "outputDirectory": "dist-healthcare",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/auth/:path*",
      "destination": "https://api.muni-pal.io/api/v1/auth/:path*"
    },
    {
      "source": "/api/v1/stripe/:path*",
      "destination": "https://api.muni-pal.io/api/v1/stripe/:path*"
    },
    {
      "source": "/api/v1/sensing/:path*",
      "destination": "https://api.muni-pal.io/api/v1/sensing/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.muni-pal.io/health"
    },
    {
      "source": "/readiness/:path*",
      "destination": "/readiness/index.readiness.html"
    },
    {
      "source": "/tools/:path*",
      "destination": "/tools/index.sensing.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.healthcare.html"
    }
  ]
}
