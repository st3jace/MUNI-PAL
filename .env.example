# Muni-Pal Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=munipal
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
USE_SQLITE=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=munipal
POSTGRES_PASSWORD=munipal_dev_password
POSTGRES_DB=munipal

# Constructed DATABASE_URL (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS (Local Docker / Redis Cloud)
# =============================================================================
# Local development
REDIS_USERNAME=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_SSL_CERT_REQS=required
# Optional full override (recommended for hosted Redis)
# REDIS_URL=redis://localhost:6379/0

# Redis Cloud / hosted Redis
# Use the exact scheme your provider shows in the connection panel.
# Some plans expose `redis://...`, others expose `rediss://...`.
# REDIS_URL=rediss://default:your-password@your-redis-cloud-host:port/0?ssl_cert_reqs=required
# REDIS_URL=redis://default:your-password@your-redis-cloud-host:port/0

# =============================================================================
# CELERY
# =============================================================================
# Optional explicit overrides (otherwise Celery falls back to REDIS_URL / host settings)
# CELERY_BROKER_URL=rediss://default:your-password@your-redis-cloud-host:port/0?ssl_cert_reqs=required
# CELERY_RESULT_BACKEND=rediss://default:your-password@your-redis-cloud-host:port/0?ssl_cert_reqs=required
# CELERY_BROKER_URL=redis://default:your-password@your-redis-cloud-host:port/0
# CELERY_RESULT_BACKEND=redis://default:your-password@your-redis-cloud-host:port/0

# =============================================================================
# ANTHROPIC (Claude API)
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model configuration
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ENFORCEMENT_V2=false
ROLE_ENFORCEMENT_V2=false
TENANT_ISOLATION_V2=false
RISK_REPORTING_V2_FOUNDATION=true
RISK_REPORTING_V2_ADVANCED_ANALYTICS=false
RISK_REPORTING_V2_ADVANCED_MIN_RELIABILITY=high
RISK_REPORTING_V2_AGE_WEIGHTING=false
RISK_REPORTING_V2_AGE_WEIGHTING_FULL_WEIGHT_DAYS=365
RISK_REPORTING_V2_AGE_WEIGHTING_MAX_PENALTY=0.20

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local storage path for artifacts
ARTIFACT_STORAGE_PATH=./artifacts

# AWS S3 (for production - uncomment and configure)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=munipal-artifacts

# =============================================================================
# DOCUMENT MANAGEMENT
# =============================================================================
DOCUMENT_STORAGE_PATH=./documents
MAX_DOCUMENT_SIZE_MB=100
DOCUMENT_MANAGEMENT_V1=false
ESIGNATURE_V1=false
VDR_V1=false
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_WEBHOOK_SECRET=
DROPBOX_SIGN_TEST_MODE=true
VDR_BASE_URL=http://localhost:5173/vdr
VDR_WATERMARK_FONT_SIZE=12
LEGAL_TEMPLATE_CATALOG_PATH=reports/legal_corpus/legal_template_catalog_latest.json

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
