# Muni-Pal Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=munipal
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=munipal
POSTGRES_PASSWORD=munipal_dev_password
POSTGRES_DB=munipal

# Constructed DATABASE_URL (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS (Local Docker / Redis Cloud)
# =============================================================================
# Local development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Redis Cloud (for production - uncomment and configure)
# REDIS_URL=redis://default:your-password@your-redis-cloud-host:port

# =============================================================================
# CELERY
# =============================================================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# =============================================================================
# ANTHROPIC (Claude API)
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model configuration
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ENFORCEMENT_V2=false
ROLE_ENFORCEMENT_V2=false
TENANT_ISOLATION_V2=false
RISK_REPORTING_V2_FOUNDATION=true
RISK_REPORTING_V2_ADVANCED_ANALYTICS=false
RISK_REPORTING_V2_ADVANCED_MIN_RELIABILITY=high

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local storage path for artifacts
ARTIFACT_STORAGE_PATH=./artifacts

# AWS S3 (for production - uncomment and configure)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=munipal-artifacts

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
